{
  "name": "itkz-workspace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "itkz",
    "backend"
  ],
  "scripts": {
    "dev": "cd itkz && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "dev:all": "run-p dev:backend dev",
    "build": "cd itkz && npm run build",
    "start": "cd itkz && npm run start",
    "start:backend": "cd backend && npm run start",
    "install:all": "npm install && cd itkz && npm install && cd ../backend && npm install",
    "deploy": "cd itkz && npm run build",
    "export": "cd itkz && npm run build"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
